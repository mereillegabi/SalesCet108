@model SalesCet108.Web.Data.Entities.Product

@{
    ViewData["Title"] = "Apagar";
}

<h1>Apagar Produto</h1>

<h3>Tem certeza de que deseja apagar este produto?</h3>
<div>
    <div class="row">
        <div class = "col-md-8">
            <dl class="row">
                <partial name="_PartialProductsDetailsDelete" />
            </dl>
        </div>
        <div class = "col-md-4">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Url.Content(Model.ImageUrl)" alt="Imagem" style="width: 300px; max-width: 100%; height: auto" />
            }
        </div>
    </div>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Apagar" class="btn btn-danger" /> 
        <a asp-action="Index" class="btn btn-success">Voltar à lista</a>
    </form>
</div>
