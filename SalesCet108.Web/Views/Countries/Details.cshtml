@model SalesCet108.Web.Data.Entities.Country

@{
    ViewData["Title"] = "Detalhes";
}

<h1>Detalhes do País</h1>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
