@model SalesCet108.Web.Data.Entities.Product

@{
    ViewData["Title"] = "Detalhes";
}

<h1>Detalhes do Produto</h1>

<div>
    <hr />

    <div class="row">
        <div class = "col-md-8">
            <dl class="row">
                <partial name="_PartialProductsDetailsDelete" />
            </dl>
        </div>

        <div class="col-md-4">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Url.Content(Model.ImageUrl)" alt="Imagem" style="width: 300px; max-width: 100%; height: auto" />
            }

        </div>
    </div>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">Editar</a> 
    <a asp-action="Index" class="btn btn-success">Voltar à lista</a>
</div>
